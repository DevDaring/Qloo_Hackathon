# LaunchLens configuration. Copy to .env and fill in. Names and placeholders only:
# never commit real values. Keys are read server-side only; the browser receives
# only the allowlisted public config (map style URL, languages, upload limit).

# --- Runtime identity --------------------------------------------------------
APP_ENV=development                      # development | production
APP_NAME=LaunchLens
APP_BASE_URL=http://127.0.0.1:8140       # public origin, e.g. https://launchlens.example.com
FRONTEND_ORIGIN=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=60

# --- Database (PostgreSQL 16 + PostGIS 3) ------------------------------------
DATABASE_URL=postgresql+asyncpg://launchlens_app:<password>@127.0.0.1:5432/launchlens
LANGGRAPH_DATABASE_URL=                  # optional; defaults to DATABASE_URL (schema "langgraph")

# --- Auth --------------------------------------------------------------------
AUTH_SECRET=<random 48+ characters>      # python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_COOKIE_SECURE=false              # true behind HTTPS
SEED_USER=TestUser                       # jury/demo login created by `python -m launchlens.demo.seed`
SEED_PASSWORD=TestUser11

# --- Demo isolation & spending ----------------------------------------------
DEMO_MODE=true
DEMO_GENERATION_ENABLED=true             # false = demo workspace cannot trigger paid generation
DEMO_DAILY_COST_USD=5.00
MAX_RUN_COST_USD=3.00
MAX_DAILY_COST_USD=10.00
PROVIDER_PRICING_FILE=                   # default deploy/provider-pricing.json

# --- Qloo (cultural/taste intelligence) -------------------------------------
QLOO_API_KEY=<qloo key>                  # alias accepted: QLOO_2009_API_KEY
QLOO_BASE_URL=https://hackathon.api.qloo.com   # alias: Qloo_Hackathon_API_Server_URL
QLOO_REQUEST_TIMEOUT_SECONDS=30
QLOO_CACHE_TTL_SECONDS=86400

# --- Reasoning: OpenAI required; OpenRouter optional explicit fallback ------
OPENAI_API_KEY=<openai key>              # alias accepted: Open_AI_2009_Key
OPENAI_MODEL=gpt-4.1-mini                # verified: JSON output + vision on this account (2026-10-08)
OPENROUTER_API_KEY=                      # alias accepted: OPENROUTER_API_KEY_1
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_PROVIDER_ALLOWLIST=
OPENROUTER_DATA_POLICY=deny
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=xai                # xai (Grok text, XAI_TEXT_MODEL) | openrouter
LLM_ALLOW_FALLBACK=false                 # never send inputs to an unconfigured fallback

# --- xAI / Grok Imagine (images and video) ----------------------------------
XAI_API_KEY=<xai key>                    # aliases accepted: GROK_API_KEY, Grok_API_KEY
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4.20-0309-non-reasoning
XAI_IMAGE_MODEL=grok-imagine-image
XAI_VIDEO_MODEL=grok-imagine-video
XAI_VIDEO_RESOLUTION=720p
XAI_POLL_INTERVAL_SECONDS=5
XAI_JOB_TIMEOUT_SECONDS=900

# --- Indian languages: Sarvam AI (translation + narration for hi/bn) --------
SARVAM_API_KEY=                          # aliases: SARVAM_2009_API_KEY, SARVAM_88_API_KEY, SARVAM_PHD_API_KEY
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER_BN=priya
SARVAM_SPEAKER_HI=kavya

# --- Narration (optional; silent captioned video when absent) ---------------
TTS_PROVIDER=auto                        # auto | sarvam | fish | fal | none
TTS_API_KEY=                             # Fish Audio key (alias: Fish_Audio_88_API_KEY)
TTS_MODEL=s2.1-pro
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_VOICE_POOL=                   # <id>:<gender>:<lang>,...  (hi/bn voices recommended)
FAL_KEY=                                 # fal.ai key for English narration (alias: FAL_AI_88_Admin_API_KEY)

# --- Geography and practical data (no keys needed for the defaults) ---------
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org   # public instance: 1 req/s, cached; use your own for volume
GEOCODING_API_KEY=
GEOCODING_CONTACT_EMAIL=
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
MAP_PUBLIC_TOKEN=
PLACES_PROVIDER=overpass
PLACES_BASE_URL=https://overpass-api.de/api/interpreter
PLACES_API_KEY=
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_API_KEY=

# --- Storage -----------------------------------------------------------------
STORAGE_BACKEND=local                    # local | s3
LOCAL_ASSET_DIR=./data/assets
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Media tools -------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FONT_ASSET_DIR=./assets/fonts

# --- Bounded execution -------------------------------------------------------
WORKER_CONCURRENCY=3
MAX_PROVIDER_CONCURRENCY=4
JOB_LEASE_SECONDS=120
MAX_AGENT_STEPS=60
MAX_RESEARCH_CALLS=80
MAX_GENERATION_ATTEMPTS=2
MAX_UPLOAD_MB=25
MAX_VIDEO_SECONDS=20
MAX_ASSETS_PER_BATCH=12
MAX_CANDIDATE_LOCATIONS=5
